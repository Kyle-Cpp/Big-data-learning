# =============================================================================
# FootPred 部署配置 —— 整个项目唯一的参数入口
# =============================================================================
# 换电脑 / 换 IP / 换用户名时，只需要改这一个文件。
#
# 用法：
#   cp footpred.env.example footpred.env   # 首次
#   vi footpred.env                       # 改成本机实际值
#
# 这个文件同时被两种程序读取：
#   1) shell 脚本：source footpred.env
#   2) Spring Boot：Spring 自动把 PREFIX_UPPER_CASE 映射到 prefix.lower.case
#      例如 FOOTPRED_LOCAL_ROOT  ->  footpred.local.root
# 所以不需要在 Java 里再配一遍。
#
# 不要提交 footpred.env 到版本库：每台机器都不一样。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 虚拟机连接（在 Windows 主机上执行脚本时使用）
# -----------------------------------------------------------------------------
# VM 使用 VMware NAT 网络，主机侧网关固定为 192.168.86.1，
# 虚拟机 IP 从 192.168.86.128-254 动态分配，因此每个人的值不同。
#
# 查询虚拟机 IP 的三种方法：
#   a) 在虚拟机终端执行：ip addr show ens33 | grep 'inet '
#   b) 在主机执行：ping 192.168.86.1 能通后，用 arp -a | findstr 192.168.86
#   c) 在 VMware 里看：虚拟机窗口右下角网络图标 -> 连接信息
#
# 建议在虚拟机里把 IP 改成静态，避免每次重启后重新填这里。
# 静态化方法见 RUNBOOK.md 第 2 节。
VM_HOST=192.168.86.128
VM_USER=root
VM_SSH_PORT=22
# 虚拟机内本项目的根目录
VM_PROJECT_ROOT=/job/footpred


# -----------------------------------------------------------------------------
# 2. 后端服务
# -----------------------------------------------------------------------------
# 监听 0.0.0.0 才能被主机浏览器访问；只监听 127.0.0.1 则只能在虚拟机内访问。
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080


# -----------------------------------------------------------------------------
# 3. Hadoop / HBase / MySQL 安装路径
# -----------------------------------------------------------------------------
# 如果不知道装在哪，运行 scripts/00-detect-env.sh，它会自动探测并打印建议值。
#
# 注意：这里填的是"安装目录"，不是 bin 目录。
# 正确：/opt/module/hadoop-3.3.6
# 错误：/opt/module/hadoop-3.3.6/bin
HADOOP_HOME=/opt/module/hadoop-3.3.6
HBASE_HOME=/opt/module/hbase-2.4.18
JAVA_HOME=/opt/module/jdk1.8.0_152
MYSQL_HOME=/usr/local/mysql

# Hadoop 配置文件目录。通常等于 $HADOOP_HOME/etc/hadoop
HADOOP_CONF_DIR=/opt/module/hadoop-3.3.6/etc/hadoop

# YARN ResourceManager 的 Web UI（用于查作业进度）
# 默认端口 8088；如果 core-site/yarn-site 改过，这里同步改。
YARN_RM_HOST=192.168.86.128
YARN_RM_PORT=8088


# -----------------------------------------------------------------------------
# 4. HDFS 路径
# -----------------------------------------------------------------------------
# 两套根目录**故意分开**，因为两份交付是独立完成的，且 HDFS 大小写敏感。
# 交接包（模块二/三、P6.1-P6.4）强制小写；搭档包（模块一/四、P6.5-P6.8）用大写。
FOOTPRED_HDFS_ROOT=/footpred
FOOTPRED_HDFS_ROOT_PARTNER=/FootPred

# 后端读取结果的根目录。部署在虚拟机上时指向 HDFS 挂载点不可行，
# 因此先用"导出法"：由 06-export-results.sh 导出到本地目录，后端读本地。
# 导出目录（虚拟机内路径）
FOOTPRED_EXPORT_ROOT=/job/footpred/export
# 后端实际读取的根目录
FOOTPRED_LOCAL_ROOT=/job/footpred/export

# 各产物的相对位置（相对于 FOOTPRED_LOCAL_ROOT）
FOOTPRED_RESULT_MODULE2_EVALUATION=handoff/models/module2/club-rf-v4
FOOTPRED_RESULT_MODULE2_CLUB_MODEL=handoff/models/module2/club-rf-v4
FOOTPRED_RESULT_MODULE2_INTERNATIONAL_MODEL=handoff/models/module2/international-rf-v1
FOOTPRED_RESULT_MODULE3_MODEL=handoff/models/module3/player-xg-v1/model.json
FOOTPRED_RESULT_SIMULATION=handoff/models/simulation_leagues_v1_10k.tsv
FOOTPRED_RESULT_REAL_TABLE=handoff/models/real_final_table.tsv
FOOTPRED_RESULT_TEAMS_BY_LEAGUE=handoff/models/teams_by_league.tsv


# -----------------------------------------------------------------------------
# 5. 推理参数（必须与模型配套，不可随意改）
# -----------------------------------------------------------------------------
# 俱乐部森林与国家队森林用不同的 draw margin，混用会导致指标对不上。
# 来源：config/handoff.env 与 models/MODEL_INFO.md
FOOTPRED_DRAW_MARGIN_CLUB=0.11
FOOTPRED_DRAW_MARGIN_INTERNATIONAL=0.15


# -----------------------------------------------------------------------------
# 6. MySQL（用于保存作业元数据，不存原始数据）
# -----------------------------------------------------------------------------
# 按 AI_HANDOFF.md 第 11 节：只存 run_id/module/status 等 9 个字段 + 最终结构化结果，
# 不存原始 CSV/JSON/SequenceFile/模型。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=footpred
MYSQL_USER=footpred
# 改成你自己的密码。含特殊字符时用单引号包住。
MYSQL_PASSWORD='change-me-please'

# 后端是否启用 MySQL。0 = 只用只读结果层，1 = 同时注册 /api/jobs 与导入接口
# 注意：只有设为 1 才会连接数据库；为 0 时后端不依赖 MySQL，也能正常启动。
FOOTPRED_MYSQL_ENABLED=0
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/footpred?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=footpred
SPRING_DATASOURCE_PASSWORD=change-me-please
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# root 账号，仅 21-init-mysql.sh 建库建表时用；日常运行不需要
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# 7.1 作业提交（可选，需 MySQL 同时启用）
# -----------------------------------------------------------------------------
# 1 = 允许通过 POST /api/jobs 提交 MapReduce 作业；0 = 只读模式
# 注意：单节点 2 核机器上并发务必保持 1，否则两个作业会争抢容器
FOOTPRED_JOB_ENABLED=0
FOOTPRED_JOB_MAX_CONCURRENT=1

# hadoop 命令的绝对路径。systemd 或后台启动时不继承 PATH，必须写全路径。
# 若不确定：which hadoop
FOOTPRED_HADOOP_BIN=/opt/module/hadoop-3.3.6/bin/hadoop

# 作业 JAR 的绝对路径。交接包按模块拆成三个 JAR，主类各不相同，
# 所以必须分别配置；用一个通用路径会让 score / champions 跑错入口。
FOOTPRED_JAR_HANDOFF=/job/footpred/app/footpred-module2.jar
FOOTPRED_JAR_HANDOFF_MODULE3=/job/footpred/app/footpred-module3.jar
FOOTPRED_JAR_HANDOFF_MODULE5=/job/footpred/app/footpred-module5.jar
FOOTPRED_JAR_PARTNER=/job/footpred/app/footpred-algo-1.0.0.jar

# YARN ResourceManager 的 Web UI，进度轮询用
YARN_RM_URL=http://192.168.86.135:8088


# -----------------------------------------------------------------------------
# 7. 三个 JAR 的位置（虚拟机内路径）
# -----------------------------------------------------------------------------
JAR_HANDOFF_ROOT=/job/footpred/app
FOOTPRED_JAR_HANDOFF_MODULE2=/job/footpred/app/footpred-module2.jar
FOOTPRED_JAR_HANDOFF_MODULE3=/job/footpred/app/footpred-module3.jar
FOOTPRED_JAR_HANDOFF_MODULE5=/job/footpred/app/footpred-module5.jar
FOOTPRED_JAR_PARTNER=/job/footpred/app/footpred-algo-1.0.0.jar


# -----------------------------------------------------------------------------
# 8. 数据目录
# -----------------------------------------------------------------------------
# 五大联赛 55 个 CSV（HDFS 内）
DATA_FIVE_LEAGUES_HDFS=/footpred/handoff/input/five-leagues
# 国家队 results.csv（HDFS 内）
DATA_INTERNATIONAL_HDFS=/footpred/handoff/input/international/results.csv
# StatsBomb 原始数据（HDFS 内，约 12GB）
DATA_STATSBOMB_HDFS=/footpred/player/raw-full

# 已准备的中间结果（HDFS 内）
PREPARED_MODULE2=/footpred/handoff/prepared/module2-v3
PREPARED_MODULE3=/footpred/handoff/prepared/module3-v1
MODEL_MODULE2_CLUB=/footpred/handoff/models/module2/club-rf-v4
MODEL_MODULE2_INTL=/footpred/handoff/models/module2/international-rf-v1
MODEL_MODULE3=/footpred/handoff/models/module3/player-xg-v1


# -----------------------------------------------------------------------------
# 9. 本次运行的 run-id
# -----------------------------------------------------------------------------
# 每次演示必须用新的 run-id。脚本发现目标已存在会拒绝执行，不覆盖历史结果。
# 留空则由脚本用时间戳自动生成（格式 yyyymmdd-HHMMSS）。
RUN_ID=
